  {
    "id": "org.kde.kid3",
    "name": "Kid3",
    "repo": "pkgforge-dev/Kid3-AppImage",
    "asset_suffix": "-anylinux-x86_64.AppImage",
    "version_regex": "([0-9.]+-[0-9]+)@",
    "version": "3.10.2-1",
    "download_url": "https://github.com/pkgforge-dev/Kid3-AppImage/releases/download/3.10.2-1%402026-11-01_1793557409/Kid3-3.10.2-1-anylinux-x86_64.AppImage",
    "asset_name": "Kid3-3.10.2-1-anylinux-x86_64.AppImage",
    "published_at": "2026-11-01T18:23:30Z",
    "summary": "Edit audio file metadata",
    "description": "With Kid3, an audio tag editor, you can edit tags in MP3, Ogg/Vorbis, DSF, FLAC, Opus, MPC,\n      APE, MP4/AAC, MP2, Speex, TrueAudio, WavPack, WMA, WAV, AIFF and tracker files.\nAll frames in the ID3 tags of MP3 files can be edited, and it is possible to convert between\n      ID3v1.1, ID3v2.3 and ID3v2.4. Synchronized lyrics can be edited, imported and exported to LRC Karaoke\n      files.\nThe tags of multiple files can be set together. It is possible to generate tags from file names\n      or the contents of other tag fields and to generate file names from tags and rename folders from\n      tags. Automatic case conversion and string replacement help to keep tags consistent.\nAlbum data can be imported from gnudb.org, MusicBrainz, Discogs, Amazon; automatic batch import\n      is available for multiple folders. It is also possible to export data and generate play lists.\nKid3 uses the KDE Frameworks. Users of other desktop environments may prefer Kid3-qt instead,\n      which is without KDE dependencies.",
    "developer": null,
    "license": "GPL-2.0+",
