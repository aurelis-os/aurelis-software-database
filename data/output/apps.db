    "id": "org.kde.knights",
    "name": "KNights",
    "repo": "pkgforge-dev/Knights-AppImage",
    "asset_suffix": "-anylinux-x86_64.AppImage",
    "version_regex": "([0-9.]+-[0-9]+)@",
    "version": "26.08.2-1",
    "download_url": "https://github.com/pkgforge-dev/Knights-AppImage/releases/download/26.08.2-1%402026-11-01_1793557813/Knights-26.08.2-1-anylinux-x86_64.AppImage",
    "asset_name": "Knights-26.08.2-1-anylinux-x86_64.AppImage",
    "published_at": "2026-11-01T18:30:15Z",
    "summary": "Chess game",
    "description": "KNights is a chess game. As a player, your goal is to defeat your opponent by checkmating their king.\nFeatures:\nLocal play between two players on the same computer\nPlay against any computer program that supports the XBoard protocol\nPlay on the Free Internet Chess Server (FICS)\nWatching two computer engines play against each other\nSupport for legal move checking\nMarkers for possible moves, opponent’s last move and sources of check\nBoard borders and site notations\nComplete time control, with Plasma-styled clocks\nSeveral themes, with the possibility of downloading new ones from within the program\nAnimated moves (configurable)\nViews for playing on a chess server, including a seek graph, text console, and chat widget\nOption to undo and redo moves\nGraphic interface for making and receiving offers from remote players\nSupport for the UCI protocol (used by Stockfish, Chessbase, and many others)\nSupport for saving and loading Portable game notation (PGN) files\nSpeak opponent’s moves\nAbility to control the program via a D-Bus interface",
    "developer": "KDE",
    "license": "GPL-2.0+",
    "categories": [
      "Game",
      "BoardGame"
    ],
    "keywords": [],
